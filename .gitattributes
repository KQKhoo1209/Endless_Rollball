# Normalize text files across Windows and other development environments.
* text=auto

# Source code, configuration, documentation, and Unity text serialization.
*.cs          text eol=lf diff=csharp
*.asmdef      text eol=lf
*.asmref      text eol=lf
*.shader      text eol=lf
*.shadergraph text eol=lf
*.compute     text eol=lf
*.cginc       text eol=lf
*.hlsl        text eol=lf
*.json        text eol=lf
*.xml         text eol=lf
*.md          text eol=lf
*.txt         text eol=lf
*.csv         text eol=lf
*.py          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf

# Unity YAML assets remain diffable. The unityyamlmerge driver can be enabled
# separately when Unity Smart Merge is configured on each development machine.
*.meta               text eol=lf
*.unity              text eol=lf
*.prefab             text eol=lf
*.asset              text eol=lf
*.mat                text eol=lf
*.anim               text eol=lf
*.controller         text eol=lf
*.overrideController text eol=lf
*.playable           text eol=lf
*.mask               text eol=lf

# Large binary art, media, archives, and plugins use Git LFS. Git LFS is already
# installed on this machine; commit this file before adding these assets.
*.fbx          filter=lfs diff=lfs merge=lfs -text
*.obj          filter=lfs diff=lfs merge=lfs -text
*.dae          filter=lfs diff=lfs merge=lfs -text
